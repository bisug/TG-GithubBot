# --- Telegram ---
TELEGRAM_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Public URL where the bot is reachable (no trailing slash)
TELEGRAM_WEBHOOK_URL=https://your-domain.com

# --- GitHub OAuth ---
# From "Client secrets" section
GITHUB_CLIENT_ID=Iv1.xyz...
GITHUB_CLIENT_SECRET=01234...

# --- Webhooks ---
# Generate a strong random string (e.g., openssl rand -hex 20)
# This acts as a shared secret for validating payloads
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# --- GitHub App mode (optional) ---
# Leave GITHUB_APP_ID unset to run in pure repo-webhook mode.
# When set, /app-webhook/<token> accepts GitHub App deliveries
# (installation events, etc.) signed with GITHUB_APP_WEBHOOK_SECRET.
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=/path/to/app-private-key.pem
# GITHUB_APP_WEBHOOK_SECRET=another_strong_random_string

# --- Database ---
MONGODB_URI=mongodb://mongo:27017
DATABASE_NAME=github_bot

# --- Security ---
# Random 32-byte string for encrypting OAuth tokens in DB
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Server ---
PORT=8080
